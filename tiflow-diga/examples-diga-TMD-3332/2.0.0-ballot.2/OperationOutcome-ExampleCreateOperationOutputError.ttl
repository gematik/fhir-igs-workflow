@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://gematik.de/fhir/tiflow-diga/OperationOutcome/ExampleCreateOperationOutputError> a fhir:OperationOutcome ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ExampleCreateOperationOutputError"] ;
  fhir:OperationOutcome.issue [
     fhir:index 0 ;
     fhir:OperationOutcome.issue.severity [ fhir:value "error" ] ;
     fhir:OperationOutcome.issue.code [ fhir:value "forbidden" ] ;
     fhir:OperationOutcome.issue.details [
       fhir:CodeableConcept.coding [
         fhir:index 0 ;
         fhir:Coding.code [ fhir:value "BLOCKED_FLOWTYPE" ]
       ] ;
       fhir:CodeableConcept.text [ fhir:value "The Flowtype may not be used in the TI-Flow-Fachdienst" ]
     ]
  ] .

# - ontology header ------------------------------------------------------------

<https://gematik.de/fhir/tiflow-diga/OperationOutcome/ExampleCreateOperationOutputError.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

